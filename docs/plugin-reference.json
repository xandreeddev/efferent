  {
    "id": "@xandreed/plugin-memory",
    "version": "0.3.0",
    "apiVersion": 1,
    "scope": "session",
    "requires": [
      "efferent/SessionEnvironment"
    ],
    "provides": [
      "efferent/Memory"
    ],
    "defaults": {
      "file": ".efferent/runtime/memory.jsonl",
      "limit": 8
    },
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$defs": {
        "Int": {
          "type": "integer",
          "description": "an integer",
          "title": "int"
        }
      },
      "type": "object",
      "required": [
        "file",
        "limit"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "limit": {
          "$ref": "#/$defs/Int",
          "description": "a number between 1 and 100",
          "title": "between(1, 100)",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
