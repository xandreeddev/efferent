      "legacyPaths": []
    },
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "legacyPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
