  {
    "id": "@xandreed/plugin-mcp",
    "version": "0.8.0-next.0",
    "apiVersion": 2,
    "scope": "session",
    "requires": [
      "efferent/SessionEnvironment",
      "efferent/ActionPolicy"
    ],
    "provides": [
      "@xandreed/core/McpClient"
    ],
    "defaults": {
      "servers": {}
    },
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "env": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "servers"
      ],
      "additionalProperties": true
    }
  },
