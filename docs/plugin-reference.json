  {
    "id": "@xandreed/plugin-memory-summary",
    "version": "0.13.0",
    "apiVersion": 2,
    "scope": "runtime",
    "requires": [],
    "optional": [],
    "provides": [
      "efferent/ConversationMemory"
    ],
    "defaults": {
      "triggerRatio": 0.8,
      "keepRatio": 0.16,
      "cooldownTurns": 3,
      "turnContext": "current",
      "replies": true,
      "digests": true,
      "media": "none",
      "maxImages": 8,
      "instructions": "Summarize the earlier part of this conversation for the same assistant, which will continue from your summary plus the newest turns. Preserve, in order: the user's goals and constraints; facts and records established (with their identifiers); answers already given; open questions and pending work. Dense prose and lists; never invent anything not in the transcript."
    },
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "triggerRatio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        },
        "keepRatio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        },
        "cooldownTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turnContext": {
          "type": "string",
          "enum": [
            "current",
            "all"
          ]
        },
        "replies": {
          "type": "boolean"
        },
        "digests": {
          "type": "boolean"
        },
        "media": {
          "type": "string",
          "enum": [
            "none",
            "inline"
          ]
        },
        "maxImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "instructions": {
          "type": "string"
        }
      },
      "required": [
        "triggerRatio",
        "keepRatio",
        "cooldownTurns",
        "turnContext",
        "replies",
        "digests",
        "media",
        "maxImages",
        "instructions"
      ],
      "additionalProperties": true
    }
  },
