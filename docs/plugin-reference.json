                  "access",
                  "refresh",
                  "expires"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "local"
                    ]
                  },
                  "baseUrl": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "credentialEnv": {
          "type": "object",
