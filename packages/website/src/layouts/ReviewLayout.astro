---
/**
 * A page of the /review section, which explains the pull request reviewer (`@xandreed/review`): its own sidebar of
 * the section's pages (a menu at phone width, where the top links are hidden), the page, an "on this page" list from
 * the headings it names, and the pager.
 */
import BaseLayout from "./BaseLayout.astro"
import Toc from "../components/Toc.astro"
import Icon from "../components/Icon.astro"
import "../styles/prose.css"
import "../styles/review.css"
import { reviewHref, reviewNav } from "../lib/nav"

interface Heading {
  depth: number
  slug: string
  text: string
}
interface Props {
  title: string
  description: string
  current: string
  headings?: Heading[]
}
const { title, description, current, headings = [] } = Astro.props

const i = reviewNav.findIndex((page) => page.slug === current)
const prev = i > 0 ? reviewNav[i - 1] : undefined
const next = i >= 0 && i < reviewNav.length - 1 ? reviewNav[i + 1] : undefined
---

<BaseLayout title={`${title} · Review`} description={description}>
  <div class="shell">
    <aside class="col-side">
      <div class="side-sticky">
        <nav class="rv-side" aria-label="The reviewer">
          <p class="grp-title">The reviewer</p>
          <ul>
            {
              reviewNav.map((page) => (
                <li>
                  <a href={reviewHref(page.slug)} class:list={["s-link", { active: page.slug === current }]} aria-current={page.slug === current ? "page" : undefined}>
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="side-note">
            <code>@xandreed/review</code>, the <code>efferent-review</code> command. Private: not on npm.
          </p>
        </nav>
      </div>
    </aside>

    <main class="col-main">
      <details class="mobile-nav">
        <summary><Icon name="menu" size={16} /> The reviewer: {reviewNav[i]?.label ?? title}</summary>
        <ul class="m-list">
          {
            reviewNav.map((page) => (
              <li>
                <a href={reviewHref(page.slug)} class:list={["s-link", { active: page.slug === current }]}>
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <article>
        <header class="doc-head">
          <p class="eyebrow">efferent-review</p>
          <h1>{title}</h1>
          <p class="lead">{description}</p>
        </header>

        <div class="prose">
          <slot />
        </div>

        <nav class="pager" aria-label="Pagination">
          {
            prev ? (
              <a class="pg prev" href={reviewHref(prev.slug)}>
                <span class="pg-dir">← Previous</span>
                <span class="pg-label">{prev.label}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="pg next" href={reviewHref(next.slug)}>
                <span class="pg-dir">Next →</span>
                <span class="pg-label">{next.label}</span>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="col-toc">
        <div class="toc-sticky"><Toc headings={headings} /></div>
      </aside>
    </main>
  </div>
</BaseLayout>

<style>
  .shell {
    max-width: none;
    margin: 0;
    padding: 0 1.75rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }
  .col-side {
    display: none;
  }
  .side-sticky,
  .toc-sticky {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    max-height: calc(100vh - var(--nav-h) - 3rem);
    overflow-y: auto;
    padding: 1.5rem 0;
  }
  .col-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2rem 0 1rem;
    min-width: 0;
  }
  .col-toc {
    display: none;
  }
  article {
    min-width: 0;
    max-width: 920px;
  }
  .rv-side {
    font-size: 0.9rem;
  }
  .grp-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .s-link {
    display: block;
    color: var(--text-dim);
    padding: 0.28rem 0.7rem;
    border-radius: 7px;
    border-left: 2px solid transparent;
    margin-left: -2px;
  }
  .s-link:hover {
    color: var(--text);
    background: var(--surface);
    text-decoration: none;
  }
  .s-link.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border-left-color: var(--accent);
    font-weight: 560;
  }
  .side-note {
    margin-top: 1.4rem;
    font-size: 0.8rem;
    color: var(--text-faint);
    line-height: 1.5;
  }
  .doc-head {
    margin-bottom: 2rem;
  }
  .doc-head .eyebrow {
    color: var(--accent-2);
    margin-bottom: 0.6rem;
  }
  .doc-head h1 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
  }
  .lead {
    margin-top: 0.8rem;
    color: var(--text-dim);
    font-size: 1.12rem;
    line-height: 1.55;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }
  .pg {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .pg.next {
    text-align: right;
    margin-left: auto;
  }
  .pg:hover {
    border-color: var(--accent-2);
    text-decoration: none;
  }
  .pg-dir {
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .pg-label {
    font-weight: 580;
    color: var(--text);
  }
  .mobile-nav {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.3rem 0.9rem;
    margin-bottom: 1.5rem;
  }
  .mobile-nav summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    cursor: pointer;
    font-weight: 560;
    color: var(--text);
  }
  .mobile-nav[open] summary {
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 0.6rem;
  }
  .m-list {
    padding-bottom: 0.5rem;
  }
  @media (max-width: 620px) {
    .shell {
      padding: 0 1rem;
    }
  }
  @media (min-width: 880px) {
    .shell {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .col-side {
      display: block;
    }
    .mobile-nav {
      display: none;
    }
  }
  @media (min-width: 1360px) {
    .col-main {
      grid-template-columns: minmax(0, 1fr) 200px;
    }
    .col-toc {
      display: block;
    }
  }
</style>
