---
/**
 * The reviewer's core and its plugins: the use cases and pure functions in the middle, each port around them with
 * the stock adapter the command line plugs in, the policies and the turn's parts, and the kernel under all of it.
 */
import Figure from "./Figure.astro"

const left = [
  { port: "Forge", adapter: "ghForge", what: "the pull request, CI runs, logs" },
  { port: "Checkout", adapter: "gitCheckout", what: "mirror clone, diff, objects" },
  { port: "HostShell", adapter: "hostShell", what: "gh and git, read whole" },
  { port: "ReviewLogs", adapter: "directoryLogs", what: "records and whole logs" },
  { port: "Validations", adapter: "sandboxValidations", what: "the PR's own commands" },
  { port: "Sandboxes", adapter: "bwrapSandboxes", what: "a bubblewrap sandbox" },
  { port: "ReviewCache", adapter: "directoryCache", what: "verdicts, snapshots" },
] as const
const right = [
  { port: "ReviewTurns", adapter: "kernelTurns", what: "a turn: finder's or check's" },
  { port: "Findings", adapter: "findingsInMemory", what: "findings and verdicts" },
  { port: "ReviewPolicies", adapter: "STOCK_POLICIES", what: "an argument: group, pack, digest…" },
] as const
const parts = ["model", "verifyModel", "memory", "tools", "journal"] as const
const ROW = 58
---

<Figure label="The reviewer's core and its plugins" minWidth={820}>
  <svg class="rv-svg" viewBox="0 0 980 560" role="img" aria-labelledby="po-t">
    <title id="po-t">Core use cases in the middle; ports with stock adapters on both sides; the kernel underneath</title>
    <rect class="core" x="10" y="6" width="14" height="14" rx="3"></rect>
    <text x="30" y="18" class="t-xs t-dim">core: fixed code</text>
    <rect class="plug" x="160" y="6" width="14" height="14" rx="3"></rect>
    <text x="180" y="18" class="t-xs t-dim">plugin: a port's adapter, the host's to swap</text>

    {
      left.map((p, i) => (
        <g>
          <rect class="plug" x="10" y={36 + i * ROW} width="290" height="48" rx="8"></rect>
          <text x="22" y={56 + i * ROW} class="t-mono t-sm t-b">{p.port}</text>
          <text x="288" y={56 + i * ROW} text-anchor="end" class="t-mono t-xs t-plug">{p.adapter}</text>
          <text x="22" y={74 + i * ROW} class="t-xs t-dim">{p.what}</text>
          <path class="line" d={`M300 ${60 + i * ROW} H346`}></path>
        </g>
      ))
    }

    <rect class="core" x="350" y="36" width="280" height="396" rx="14"></rect>
    <text x="366" y="60" class="t-b">The reviewer's core</text>
    <text x="366" y="88" class="t-mono t-sm">prepareReview</text>
    <text x="366" y="106" class="t-xs t-dim">fetch and prepare, no model</text>
    <text x="366" y="136" class="t-mono t-sm">reviewPullRequest</text>
    <text x="366" y="154" class="t-xs t-dim">groups, find, merge, check, records</text>
    <text x="366" y="184" class="t-mono t-sm">the turn's loop</text>
    <text x="366" y="202" class="t-xs t-dim">steps, closing call, harvest</text>
    <text x="366" y="218" class="t-xs t-dim">(inside the stock kernelTurns)</text>
    <text x="366" y="248" class="t-mono t-sm">pure functions</text>
    <text x="366" y="266" class="t-xs t-dim">parseUnifiedDiff · packDiff · groupFiles</text>
    <text x="366" y="282" class="t-xs t-dim">focusPrefix · verifyPrompt · mergeFindings</text>
    <text x="366" y="298" class="t-xs t-dim">quoteWithin · reviewReport · reportText</text>
    <text x="366" y="328" class="t-mono t-sm">the model's six tools</text>
    <text x="366" y="346" class="t-xs t-dim">reviewTools: readLines · searchCode</text>
    <text x="366" y="362" class="t-xs t-dim">listFiles · readDiff · reportFinding</text>
    <text x="366" y="378" class="t-xs t-dim">verdict (the handlers are swappable)</text>
    <text x="366" y="410" class="t-xs t-faint">the orchestration is code, never a model</text>

    {
      right.map((p, i) => (
        <g>
          <path class="line" d={`M634 ${60 + i * ROW} H680`}></path>
          <rect class="plug" x="680" y={36 + i * ROW} width="290" height="48" rx="8"></rect>
          <text x="692" y={56 + i * ROW} class="t-mono t-sm t-b">{p.port}</text>
          <text x="958" y={56 + i * ROW} text-anchor="end" class="t-mono t-xs t-plug">{p.adapter}</text>
          <text x="692" y={74 + i * ROW} class="t-xs t-dim">{p.what}</text>
        </g>
      ))
    }
    <rect class="box" x="680" y="214" width="290" height="218" rx="10"></rect>
    <text x="692" y="236" class="t-sm t-b"><tspan class="t-mono">kernelTurns</tspan>'s parts</text>
    {
      parts.map((p, i) => (
        <g>
          <rect class="plug" x="692" y={248 + i * 34} width="266" height="26" rx="6"></rect>
          <text x="704" y={265 + i * 34} class="t-mono t-xs">{p}</text>
        </g>
      ))
    }
    <text x="830" y="265" class="t-xs t-dim">a LanguageModel layer</text>
    <text x="830" y="299" class="t-xs t-dim">the checks' model</text>
    <text x="830" y="333" class="t-xs t-dim">flatMemory</text>
    <text x="830" y="367" class="t-xs t-dim">reviewToolHandlers</text>
    <text x="830" y="401" class="t-xs t-dim">directoryJournal</text>

    <rect class="box-2" x="10" y="460" width="960" height="88" rx="12"></rect>
    <text x="26" y="484" class="t-b">The kernel</text>
    <text x="120" y="484" class="t-mono t-xs t-dim">@xandreed/core · @xandreed/sdk · @xandreed/sdk/node</text>
    <text x="26" y="508" class="t-xs t-dim">Sessions and JournalStorage (each turn a session in a journal of its own) · modelAnswer and callTool (store what they read and run)</text>
    <text x="26" y="528" class="t-xs t-dim">ModelSpend (hold, then settle) · flatMemory · framed, hostNote, clipTo (untrusted text) · openAiCompatibleModel · directoryJournal</text>
  </svg>
  <Fragment slot="caption">
    <strong>Neovim-style: a small core, everything else a plugin.</strong> Each port is an Effect
    <code>Context.Service</code>; each plugin is a plain <code>Layer</code> that a host provides. The command line is
    just one host: it plugs in the stock adapter for every port. The kernel underneath is the framework's own, the same
    one the learn track teaches.
  </Fragment>
</Figure>
