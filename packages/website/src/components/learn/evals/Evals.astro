---
// "Run evals": the suite of evals.ts, once for each candidate, on the code as it stands (see learn/playground.ts,
// `data-evals`). The table under it fills as trials end; Stop interrupts the run, and what it finished stays.
---

<p class="learn-try">
  <button class="btn btn-primary" type="button" data-evals="run">Run evals</button>
  <button class="btn" type="button" data-evals="stop" hidden>Stop</button>
</p>
<div class="learn-evals" data-evals-results hidden></div>
