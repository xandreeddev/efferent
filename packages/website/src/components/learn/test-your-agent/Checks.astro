---
// A button that runs the checks of checks.ts as it stands, each on a stack of its own, and the list they land in
// (see learn/playground.ts, `data-kit`). The list says in its own words when the checks did not run.
---

<p class="learn-try"><button class="btn btn-primary" type="button" data-kit="checks">Run checks</button></p>
<ul class="learn-kit" data-kit-results="checks" data-kit-refused="The checks did not run." hidden></ul>
