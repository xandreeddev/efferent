---
// "Check the graders": each grader of graders.ts against the labels of labels.ts, with calibration.ts, on the code as
// it stands (see learn/playground.ts, `data-graders`). The table under it fills as checks end; Stop interrupts the
// run, and what it finished stays.
---

<p class="learn-try">
  <button class="btn btn-primary" type="button" data-graders="run">Check the graders</button>
  <button class="btn" type="button" data-graders="stop" hidden>Stop</button>
</p>
<div class="learn-evals" data-graders-results hidden></div>
