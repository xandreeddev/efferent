---
// Step 8: each button rewrites the agent's code and rebuilds (see learn/playground.ts, `data-exp`).
const experiments = [
  { id: "pirate", title: "Change the personality", button: "Make it a pirate", text: "Only the system text changes. Echo ignores it; try a real model. The stack shows the new text at the top, and nothing of the request can be reused from the one before." },
  { id: "no-memory", title: "Break it on purpose", button: "Remove the memory line", text: "The loop needs a Memory, and now nothing provides one. The stack does not build, and the Code pane says what is missing." },
  { id: "tiny-budget", title: "Starve the budget", button: "Set the budget to 5", text: "The system text alone is over 5 tokens. The turn fails with memory's own error, OverBudget, and the chat offers to raise the budget." },
  { id: "swap-memory", title: "Swap the memory", button: "Swap windowMemory and lastMessages", text: "The other memory reads the same journal, so the conversation goes on. Send a message and compare what each one sends." },
]
---

<ol class="learn-exp">
  {
    experiments.map((exp) => (
      <li>
        <strong>{exp.title}</strong>
        <p>{exp.text}</p>
        <button class="btn" type="button" data-exp={exp.id}>{exp.button}</button>
      </li>
    ))
  }
</ol>
