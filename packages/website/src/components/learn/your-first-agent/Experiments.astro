---
// Step 8: each button rewrites one of the learner's files and runs it again (see learn/playground.ts, `data-exp`).
const experiments = [
  { id: "pirate", title: "Change the personality", button: "Make it a pirate", text: "Only the system text changes. Echo ignores it; try a real model. In the Context tab, the next prompt shares nothing with the one before: the change is at its very start." },
  { id: "reminder", title: "Remind it every time", button: "Add a reminder after the context", text: "turn adds a message after the context: sent every time, stored never. The Prompt column marks it added by your code, and the cache bar still grows, because the start of the prompt is unchanged." },
  { id: "shout", title: "Show one thing, store another", button: "Shout the answer", text: "turn returns the answer in capitals. The chat shows them; the journal stores what the model wrote. Open a record to compare." },
  { id: "last-two", title: "Forget", button: "Keep the last two messages", text: "memory.ts sends only the last two. Older records are left out, and the cache breaks on every prompt." },
  { id: "no-memory", title: "Break it on purpose", button: "Remove the memory module", text: "main no longer provides Memory. The program starts, and stops at the first message, which asks for a Memory nothing provides. The foot of the Code pane says so." },
]
---

<ol class="learn-exp">
  {
    experiments.map((exp) => (
      <li>
        <strong>{exp.title}</strong>
        <p>{exp.text}</p>
        <button class="btn" type="button" data-exp={exp.id}>{exp.button}</button>
      </li>
    ))
  }
</ol>
