---
// Each button rewrites one line of the learner's code and runs it again (see learn/playground.ts, `data-exp`, and
// lessons/connected-memory/config-edit.ts). What is kept outlives a rebuild: only a reload empties the knowledge
// session.
const experiments = [
  {
    exp: "walk-zero", title: "No walk by subject", button: "Set walk to 0",
    text: "memory.ts now reads withKnowledge({ walk: 0, … }): a request is sent the memories ranked first, and none the walk by subject would add.",
  },
  {
    exp: "review-off", title: "No review", button: "Turn review off",
    text: "curator.ts now reads const options = { review: false }: the curator is asked once for each turn, and its first reply is checked and stored as it is.",
  },
]
---

<ol class="learn-exp">
  {
    experiments.map((one) => (
      <li>
        <strong>{one.title}</strong>
        <p>{one.text}</p>
        <button class="btn" type="button" data-exp={one.exp}>{one.button}</button>
      </li>
    ))
  }
</ol>
