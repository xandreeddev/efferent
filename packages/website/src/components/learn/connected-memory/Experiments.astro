---
// Step 9: each button rewrites the learner's memory.ts and runs it again (see learn/playground.ts, `data-exp`). Each
// starts from a page with no link: the links outlive a rebuild, and only a reload empties the graph session.
const experiments = [
  {
    exp: "hops-one", title: "One link away", button: "Set hops to 1",
    text: "Reload the page first, so that no link stands. memory.ts now reads withGraph({ hops: 1, … }). Press the first two buttons under the chat, the seven sentences and In what city does Ana work?. The walk stops at Ana's own links: the note lists e1: Ana works at Acme., then e7, e6, e4 and e3, and not e2: Acme is in Lisbon., which is two links away. Echo answers From what I know: Ana works at Acme. Ana drives a red car. There is no city in it.",
  },
  {
    exp: "by-distance", title: "By distance alone", button: "Rank by distance",
    text: "Reload the page first. memory.ts now holds a wrapper of your own, byDistance, written over the kernel's parts: knownLinks reads the links, questionOf your last message, namedIn the things it names, and linksNote writes the note. It asks near, the function withGraph walks and ranks with (step 5), with the names of those things and none of the question's other words. With no word left to rank by, the links are ranked by how many links away they are, then the newest first. Press the first two buttons under the chat. The note lists e7, e6, e4, e3 and e1: Ana's own links, the newest first, and not Acme is in Lisbon. Echo answers From what I know: Ana drives a red car. Ana is the sister of Eva. These are the five sentences lesson 11's ranking sends when the seven are facts. The words of the path are what put the city second.",
  },
  {
    exp: "follow-only", title: "No wrapper", button: "Take the wrapper away",
    text: "Reload the page first. memory.ts now provides the flat memory with no wrapper. Press the first two buttons under the chat. The seven links are stored, and the question is sent none of them: Echo answers You said: \"In what city does Ana work?\". I can also see 3 earlier messages. Press What is Acme linked to?. Echo calls followThings, which reads the graph session whenever it is called, and answers Following Acme: Acme is in Lisbon. Ana works at Acme. Without the wrapper no request is sent a note of links, not even this question's: the links reach the model through the tool's result.",
  },
]
---

<ol class="learn-exp">
  {
    experiments.map((one) => (
      <li>
        <strong>{one.title}</strong>
        <p>{one.text}</p>
        <button class="btn" type="button" data-exp={one.exp}>{one.button}</button>
      </li>
    ))
  }
</ol>
