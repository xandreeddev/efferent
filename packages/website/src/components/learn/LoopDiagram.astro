---
// The loop, live: lights up from the real TurnEvents the playground publishes.
---

<figure class="learn-fig" data-loop-diagram>
  <svg class="dg" viewBox="0 0 640 250" role="img" aria-labelledby="loop-t loop-d">
    <title id="loop-t">One turn through the step loop</title>
    <desc id="loop-d">Your message goes to the memory window, which builds the context. The step loop sends it to the model and receives the answer, then decides whether to stop or go around again, and finally returns the reply.</desc>

    <g class="node" data-node="you"><rect class="box" x="8" y="92" width="104" height="60" rx="12" />
      <text x="60" y="127" font-size="14" text-anchor="middle">your message</text></g>
    <g class="node" data-node="memory"><rect class="box" x="148" y="92" width="140" height="60" rx="12" />
      <text class="mono" x="218" y="118" font-size="13" text-anchor="middle">memory window</text>
      <text class="dim" x="218" y="138" font-size="12" text-anchor="middle">builds the context</text></g>
    <g class="node" data-node="loop"><rect class="box" x="324" y="92" width="122" height="60" rx="12" />
      <text class="mono" x="385" y="118" font-size="13" text-anchor="middle">step loop</text>
      <text class="dim" x="385" y="138" font-size="12" text-anchor="middle">asks, records</text></g>
    <g class="node" data-node="model"><rect class="box" x="490" y="92" width="142" height="60" rx="12" />
      <text class="mono" x="561" y="118" font-size="13" text-anchor="middle">LanguageModel</text>
      <text class="dim" x="561" y="138" font-size="12" text-anchor="middle">writes the answer</text></g>
    <g class="node" data-node="reply"><rect class="box" x="324" y="196" width="122" height="44" rx="12" />
      <text x="385" y="223" font-size="14" text-anchor="middle">the reply</text></g>

    <g class="eg" data-edge="you-memory"><path class="edge" d="M112 122 H136" /><path class="head" d="M132 116 L144 122 L132 128 Z" /></g>
    <g class="eg" data-edge="memory-loop"><path class="edge" d="M288 122 H312" /><path class="head" d="M308 116 L320 122 L308 128 Z" /></g>
    <g class="eg" data-edge="loop-model"><path class="edge" d="M446 110 H478" /><path class="head" d="M474 104 L486 110 L474 116 Z" /></g>
    <g class="eg" data-edge="model-loop"><path class="edge" d="M490 134 H458" /><path class="head" d="M462 128 L450 134 L462 140 Z" /></g>
    <g class="eg" data-edge="loop-again"><path class="edge" d="M356 92 C356 42 414 42 414 86" /><path class="head" d="M408 82 L414 94 L420 82 Z" /></g>
    <g class="eg" data-edge="loop-reply"><path class="edge" d="M385 152 V184" /><path class="head" d="M379 180 L385 192 L391 180 Z" /></g>
    <text class="dim" x="385" y="32" font-size="12" text-anchor="middle">another step?</text>
  </svg>
  <ol class="dg-list">
    <li>Your message goes to the memory window, which builds the context.</li>
    <li>The step loop sends it to the model and records the answer.</li>
    <li>The loop decides: another step, or finish and return the reply.</li>
  </ol>
  <p class="dg-log" aria-live="polite" data-log>Send a message in the playground and watch the turn travel through.</p>
  <figcaption>Live: each highlight is a real event from your agent's turn.</figcaption>
</figure>

<script>
  const root = document.querySelector<HTMLElement>("[data-loop-diagram]")
  if (root) {
    const nodes = new Map([...root.querySelectorAll<SVGGElement>("[data-node]")].map((n) => [n.dataset.node!, n]))
    const edges = new Map([...root.querySelectorAll<SVGGElement>("[data-edge]")].map((n) => [n.dataset.edge!, n]))
    const log = root.querySelector<HTMLElement>("[data-log]")!
    const on = (node: string, state: "on" | "done" | "off") => {
      const el = nodes.get(node)
      if (!el) return
      el.toggleAttribute("data-on", state === "on")
      el.toggleAttribute("data-done", state === "done")
    }
    const edge = (name: string, active: boolean) => edges.get(name)?.toggleAttribute("data-on", active)
    const reset = () => {
      nodes.forEach((_, k) => on(k, "off"))
      edges.forEach((_, k) => edge(k, false))
    }
    const say = (text: string) => { log.textContent = text }

    window.addEventListener("learn:start", () => {
      reset(); on("you", "on"); edge("you-memory", true); say("Your message goes in.")
    })
    window.addEventListener("learn:event", (e) => {
      const ev = (e as CustomEvent<{ _tag: string; [k: string]: unknown }>).detail
      switch (ev._tag) {
        case "step.started":
          on("you", "done"); on("loop", "on"); edge("loop-again", false); edge("loop-reply", false)
          say(`step ${ev.step}: the loop begins a step.`); break
        case "context.built":
          on("memory", "done"); edge("memory-loop", true)
          say(`memory built the context (~${ev.estimatedTokens} tokens of ${ev.budgetTokens}).`); break
        case "assistant.delta":
          on("model", "on"); edge("loop-model", true); edge("model-loop", true)
          say("the model is writing; the loop receives each piece."); break
        case "assistant.message":
          on("model", "done"); say("the model finished its answer; the loop records it."); break
        case "step.ended":
          edge("loop-again", true); say(`step ${ev.step} ended (${String(ev.status)}).`); break
        case "completion.evaluated":
          say("the loop decides whether to go again: no tool calls, so the reply stands."); break
      }
    })
    window.addEventListener("learn:done", () => {
      on("loop", "done"); on("reply", "on"); edge("loop-reply", true); edge("loop-again", false); say("The reply goes back to you.")
    })
  }
</script>
