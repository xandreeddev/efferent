---
// The loop, live: lights up from the kernel events the page hears on Core (learn/runtime.ts, `LessonEvent`).
---

<figure class="learn-fig" data-loop-diagram>
  <svg class="dg" viewBox="0 0 640 250" role="img" aria-labelledby="loop-t loop-d">
    <title id="loop-t">One turn through the step loop</title>
    <desc id="loop-d">Your message waits in the inbox until its turn. The step loop stores it, asks memory to build the request, sends the request to the model and stores the answer, then returns the reply. With tools it would go around again.</desc>

    <g class="node" data-node="you"><rect class="box" x="8" y="92" width="104" height="60" rx="12" />
      <text x="60" y="118" font-size="14" text-anchor="middle">your message</text>
      <text class="dim" x="60" y="138" font-size="12" text-anchor="middle">in the inbox</text></g>
    <g class="node" data-node="memory"><rect class="box" x="148" y="92" width="140" height="60" rx="12" />
      <text class="mono" x="218" y="118" font-size="13" text-anchor="middle">memory</text>
      <text class="dim" x="218" y="138" font-size="12" text-anchor="middle">builds the request</text></g>
    <g class="node" data-node="loop"><rect class="box" x="324" y="92" width="122" height="60" rx="12" />
      <text class="mono" x="385" y="118" font-size="13" text-anchor="middle">step loop</text>
      <text class="dim" x="385" y="138" font-size="12" text-anchor="middle">asks, stores</text></g>
    <g class="node" data-node="model"><rect class="box" x="490" y="92" width="142" height="60" rx="12" />
      <text class="mono" x="561" y="118" font-size="13" text-anchor="middle">LanguageModel</text>
      <text class="dim" x="561" y="138" font-size="12" text-anchor="middle">writes the answer</text></g>
    <g class="node" data-node="reply"><rect class="box" x="324" y="196" width="122" height="44" rx="12" />
      <text x="385" y="223" font-size="14" text-anchor="middle">the reply</text></g>

    <g class="eg" data-edge="you-memory"><path class="edge" d="M112 122 H136" /><path class="head" d="M132 116 L144 122 L132 128 Z" /></g>
    <g class="eg" data-edge="memory-loop"><path class="edge" d="M288 122 H312" /><path class="head" d="M308 116 L320 122 L308 128 Z" /></g>
    <g class="eg" data-edge="loop-model"><path class="edge" d="M446 110 H478" /><path class="head" d="M474 104 L486 110 L474 116 Z" /></g>
    <g class="eg" data-edge="model-loop"><path class="edge" d="M490 134 H458" /><path class="head" d="M462 128 L450 134 L462 140 Z" /></g>
    <g class="eg" data-edge="loop-again"><path class="edge" d="M356 92 C356 42 414 42 414 86" /><path class="head" d="M408 82 L414 94 L420 82 Z" /></g>
    <g class="eg" data-edge="loop-reply"><path class="edge" d="M385 152 V184" /><path class="head" d="M379 180 L385 192 L391 180 Z" /></g>
    <text class="dim" x="385" y="32" font-size="12" text-anchor="middle">another step? only with tools</text>
  </svg>
  <ol class="dg-list">
    <li>Your message waits in the inbox until its turn opens.</li>
    <li>The step loop stores it; memory builds the request from the journal.</li>
    <li>The loop sends the request to the model, stores the answer, and returns the reply.</li>
  </ol>
  <p class="dg-log" aria-live="polite" data-log>Send a message in the playground and watch the turn travel through.</p>
  <figcaption>Live: each highlight is a kernel event the page heard.</figcaption>
</figure>

<script>
  import { Match } from "effect"
  import type { LessonEvent } from "../../learn/runtime.ts"

  const root = document.querySelector<HTMLElement>("[data-loop-diagram]")
  if (root) {
    const nodes = new Map([...root.querySelectorAll<SVGGElement>("[data-node]")].map((n) => [n.dataset.node!, n]))
    const edges = new Map([...root.querySelectorAll<SVGGElement>("[data-edge]")].map((n) => [n.dataset.edge!, n]))
    const log = root.querySelector<HTMLElement>("[data-log]")!
    const on = (node: string, state: "on" | "done" | "off") => {
      const el = nodes.get(node)
      if (!el) return
      el.toggleAttribute("data-on", state === "on")
      el.toggleAttribute("data-done", state === "done")
    }
    const edge = (name: string, active: boolean) => edges.get(name)?.toggleAttribute("data-on", active)
    const reset = () => {
      nodes.forEach((_, k) => on(k, "off"))
      edges.forEach((_, k) => edge(k, false))
    }
    const say = (text: string) => { log.textContent = text }

    window.addEventListener("learn:start", () => {
      reset(); on("you", "on"); say("Your message goes into the inbox.")
    })
    window.addEventListener("learn:event", (e) => {
      const event = (e as CustomEvent<LessonEvent>).detail
      Match.value(event).pipe(
        Match.tag("Queued", (queued) => { on("you", "on"); say(`queued with ticket ${queued.ticket}.`) }),
        Match.tag("TurnStarted", (started) => { reset(); on("you", "done"); on("loop", "on"); say(`turn ${started.turn} opens.`) }),
        Match.tag("UserMessage", (message) => { edge("you-memory", true); say(`turn ${message.turn}: the loop stores your message in the journal.`) }),
        Match.tag("WindowDropped", (dropped) => { on("memory", "on"); say(`the window leaves out older turns, through record ${dropped.through}, and records that.`) }),
        Match.tag("RequestSent", (sent) => {
          on("memory", "done"); edge("memory-loop", true); edge("loop-model", true)
          say(`step ${sent.step}: memory built a request of ${sent.messages} message${sent.messages === 1 ? "" : "s"} (~${sent.estimatedTokens} of ${sent.budgetTokens} tokens); the loop stores it and sends it.`)
        }),
        Match.tag("Delta", () => { on("model", "on"); edge("model-loop", true); say("the model is writing; each piece is published as it arrives.") }),
        Match.tag("AssistantMessage", () => { on("model", "done"); say("the model finished; the loop stores the answer. It asked for no tool, so the turn ends.") }),
        Match.tag("TurnEnded", (ended) => {
          on("loop", "done"); on("reply", "on"); edge("loop-reply", true)
          say(ended.outcome._tag === "Completed" ? `turn ${ended.turn} closes: the reply goes back to you.` : `turn ${ended.turn} closes: ${ended.outcome._tag.toLowerCase()}.`)
        }),
        Match.orElse(() => {}),
      )
    })
    window.addEventListener("learn:done", () => { edge("loop-again", false) })
  }
</script>
