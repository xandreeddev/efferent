---
// The right-hand side of a lesson: the model bar, the Code pane (the
// lesson's files, and the Context tab that shows what happened in each
// turn), and the Chat. Behaviour lives in learn/playground.ts; markup
// carries `data-*` hooks. What it shows of a lesson comes from the lesson's
// definition.
import { Option } from "effect"
import { lessonOf } from "../../learn/lessons/index.ts"

interface Props {
  /** The lesson's slug, as in /learn/<slug>. */
  lesson: string
}
const { lesson: slug } = Astro.props
const lesson = Option.getOrThrowWith(lessonOf(slug), () => new Error(`no lesson definition for ${slug}: add it to learn/lessons/index.ts`))
---

<section class="wb-bench" aria-label="Playground" data-lesson={lesson.slug}>
  <div class="wb-modelbar">
    <button class="mb-toggle" type="button" data-model-toggle aria-expanded="false" aria-controls="model-panel">
      <span class="mb-label">Model</span>
      <strong data-model-name>Echo (instant)</strong>
      <span aria-hidden="true">▾</span>
    </button>
    <span class="pg-chip" data-chip data-state="idle">starting…</span>
    <div class="mb-progress" data-model-progress hidden>
      <div class="pg-bar"><i></i></div>
      <span data-model-progress-text></span>
    </div>
    <div class="mb-panel" id="model-panel" data-model-panel hidden>
      <p class="mb-hint" data-model-hint></p>
      <ul class="pg-models" data-models></ul>
    </div>
  </div>

  <div class="wb-grid" data-grid>
    <section class="pane pane-code" data-pane="code" aria-label="Code and context">
      <header class="pane-head">
        <div class="files" role="tablist" aria-label="Files and context">
          {lesson.files.map((file) => <button role="tab" type="button" data-file={file.id} aria-selected={String(file.id === lesson.mainFile)}>{file.label}{file.readOnly && <span class="ro" title="Read-only">ro</span>}</button>)}
          <button role="tab" type="button" class="tab-context" data-file="context" aria-selected="false" title="What happened in each turn: the journal, memory and the prompt">
            <span class="dot" aria-hidden="true"></span>Context
          </button>
        </div>
        <span class="syntax" data-syntax aria-live="polite"></span>
        <div class="pane-actions" data-code-actions>
          <button class="btn btn-quiet" type="button" data-format title="Tidy the indentation and line breaks of this file (Shift + Alt + F)">Format</button>
          <button class="btn btn-quiet" type="button" data-reset-code title="Restore the starter code of every file, and run it">Reset</button>
          <button class="btn btn-primary" type="button" data-rebuild title="Run your code again (Ctrl or Cmd + Enter). Waiting messages are kept.">Rebuild</button>
          <button class="icon-btn" type="button" data-max aria-label="Maximise Code pane" title="Maximise">⤢</button>
        </div>
      </header>
      <div class="pane-body editor-host" data-editor></div>
      <div class="pane-body tr" data-trace hidden>
        <div class="tr-sessions" data-tr-sessions role="group" aria-label="Sessions" hidden></div>
        <div class="tr-bar">
          <div class="tr-turns" data-tr-turns role="group" aria-label="Turns"></div>
          <label class="tr-follow"><input type="checkbox" data-tr-follow checked /> follow the latest</label>
          <button class="btn btn-quiet" type="button" data-tr-replay title="Walk through this turn's steps one by one">▶ Replay</button>
        </div>
        <div class="tr-empty" data-tr-empty>
          <p><strong>Nothing has happened yet.</strong> Send a message in the chat: each turn shows up here as your program runs it.</p>
          <ol class="tr-empty-steps">
            <li>the turn opens</li><li>your message is stored</li><li>memory builds the context</li><li>the prompt is sent</li><li>the answer streams</li><li>the answer is stored</li><li>the turn closes</li>
          </ol>
        </div>
        <div class="tr-body" data-tr-body hidden>
          <ol class="tr-steps" data-tr-steps aria-label="The turn's steps"></ol>
          <p class="tr-step-detail" data-tr-step-detail aria-live="polite"></p>
          <div class="tr-calls" data-tr-calls role="group" aria-label="Model calls of this turn" hidden></div>
          <div class="tr-cols">
            <section class="tr-col" data-col="journal" aria-label="The journal">
              <h3>Journal <small data-tr-journal-head></small></h3>
              <p class="tr-col-sub">Everything stored, in order: the single source of truth.</p>
              <div class="tr-filters" data-tr-filters role="group" aria-label="Filter by tag"></div>
              <ol class="tr-list" data-tr-journal></ol>
            </section>
            <section class="tr-col" data-col="memory" aria-label="Memory's context">
              <h3>Memory <small data-tr-memory-head></small></h3>
              <p class="tr-col-sub">What <code>memory.context</code> took from the journal for this turn.</p>
              <ol class="tr-list" data-tr-memory></ol>
            </section>
            <section class="tr-col" data-col="prompt" aria-label="The prompt">
              <h3>Prompt <small data-tr-prompt-head></small></h3>
              <p class="tr-col-sub">What the model received: built fresh each turn, never stored.</p>
              <ol class="tr-list" data-tr-prompt></ol>
            </section>
          </div>
        </div>
        <details class="tr-log-box">
          <summary>Events log <span class="tr-log-count" data-tr-log-count>0</span> <small>everything on Core and what your program told the chat, in order</small></summary>
          <ol class="tr-log" data-tr-log></ol>
        </details>
      </div>
      <div class="pane-foot" data-build data-state="idle" aria-live="polite">Your program has not run yet.</div>
    </section>

    <section class="pane pane-chat" data-pane="chat" aria-label="Chat">
      <header class="pane-head">
        <h2>Chat</h2>
        <span class="chat-status" data-status aria-live="polite"></span>
        <div class="pane-actions">
          <button class="btn btn-quiet" type="button" data-new-chat title="Start over: a new, empty conversation. The old one stays in the journal store.">Clear context</button>
          <button class="icon-btn" type="button" data-max aria-label="Maximise Chat pane" title="Maximise">⤢</button>
        </div>
      </header>
      <div class="pane-body" data-scroll>
        <ol class="pg-messages" data-messages aria-live="polite"></ol>
        <p class="pg-empty" data-empty>Ask the agent something. Echo needs no download; pick another model from the bar above.</p>
      </div>
      <div class="chips" data-chips>
        {lesson.chips.map((chip) => <button type="button" class="chip" data-chip-text={chip}>{chip}</button>)}
        <button type="button" class="chip chip-three" data-send-three title="Send three messages at once: each waits in the chat's queue, and gets a turn of its own, in order">Send three at once</button>
      </div>
      <form class="compose" data-compose>
        <textarea data-input rows="2" placeholder="Message the agent. Enter sends, Shift+Enter adds a line. Messages sent while it answers wait in the queue." aria-label="Message" disabled></textarea>
        <button class="btn btn-primary" type="submit" data-send disabled>Send</button>
        <button class="btn" type="button" data-stop hidden title="Stop the turn, drop the waiting messages, and run your program again">Stop</button>
      </form>
      <p class="hint" data-hint></p>
    </section>
  </div>
</section>

<script>
  import "../../learn/playground.ts"
</script>
