---
import BaseLayout from "../layouts/BaseLayout.astro"
import { href, GITHUB } from "../lib/nav"
const modules = [
  ["01", "Loop", "Choose how the agent thinks, acts, and stops."],
  ["02", "Context & memory", "Decide what survives a turn, a session, or a restart."],
  ["03", "Tools & policy", "Give the agent capabilities with explicit boundaries."],
  ["04", "Evidence", "Replay sessions. Fork experiments. Evaluate outcomes."],
]
---
<BaseLayout title="Efferent — compose the agent" description="An Effect-native agent SDK and a focused coding terminal. Configurable plugins from the agent loop to memory, with durable sessions and reusable evals.">
  <section class="intro">
    <p class="eyebrow">EFFECT + BUN / COMPOSABLE AGENTS</p>
    <div class="headline"><h1>Compose the agent.<br /><em>Own the harness.</em></h1><p>A coding terminal you can make your own.<br />An SDK that lets you replace the parts that matter.</p></div>
    <div class="actions"><a class="primary" href={href("/docs/getting-started")}>Start building <span>↗</span></a><a href={href("/docs/concepts/harness")}>Explore the SDK →</a></div>
    <div class="workbench">
      <div class="terminal" aria-label="Illustrative Efferent terminal session">
        <div class="bar"><strong>efferent</strong><span>smith / ~/workspace</span><span class="ready">● Ready</span></div>
        <div class="conversation"><p class="label">YOU</p><p>Make this agent remember useful project decisions.</p><p class="label agent">SMITH</p><p>I’ll inspect the memory plugin and add a workspace-scoped implementation.</p><div class="tool">✓ read_file <span>efferent.config.ts</span></div><div class="tool">✓ edit_file <span>plugins/project-memory.ts</span></div><p>The memory service is connected. Its configuration is available in <code>/plugins</code>.</p></div>
        <div class="composer">› <span>What should we build next?</span><span class="cursor"></span></div><div class="keys">Enter send <span>Shift+Enter newline</span><span>Ctrl+P commands</span></div>
      </div>
      <aside><p class="eyebrow">YOUR COMPOSITION</p><h2>Every capability<br />has a place.</h2><div class="graph"><span>models</span><span>loop</span><span>tools</span><span>policy</span><span>context</span><span class="selected">memory ↗</span><span>sessions</span><span>telemetry</span></div><p>Typed services. Validated options.<br />Scoped resources. Replaceable implementations.</p><a href={href("/docs/concepts/providers")}>Meet the plugins →</a></aside>
    </div>
    <div class="install"><code><span>$</span> bun run efferent</code><p>Source available now · Local prerelease builds · Linux first</p></div>
  </section>
  <section class="modules" id="ecosystem"><header><p class="eyebrow">FROM TERMINAL TO FRAMEWORK</p><h2>A small core.<br />Room for your ideas.</h2><p>Start with Smith’s coding preset. Compose your own agent with the same SDK. Keep the behavior you need and supply your own services.</p></header><div class="module-list">{modules.map(([number,title,description]) => <a href={href("/docs/concepts/architecture")}><span>{number}</span><div><h3>{title}</h3><p>{description}</p></div><span>↗</span></a>)}</div></section>
  <section class="closing"><p class="eyebrow">BUILT IN THE OPEN</p><h2>Your agent should fit your work.</h2><p>Effect Layers for composition. Durable events for evidence. Deterministic checks for confidence.</p><a class="primary" href={GITHUB}>Read the source ↗</a></section>
</BaseLayout>
<style>
  .intro,.modules,.closing{max-width:1180px;margin:auto;padding:4.5rem 1.5rem}.eyebrow{font: .72rem var(--font-mono);letter-spacing:.14em;color:var(--accent-2)}.headline{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin:1.6rem 0}h1{font-size:clamp(2.8rem,5.8vw,4.8rem);line-height:1.05;letter-spacing:-.055em;font-weight:550}h1 em{font-style:normal;color:var(--accent-2)}.headline>p{color:var(--text-dim);line-height:1.8;padding-bottom:.35rem}.actions{display:flex;align-items:center;gap:1.7rem;margin:2rem 0 3.5rem}.primary{display:inline-flex;gap:2.5rem;background:var(--accent-2);color:var(--bg);padding:.9rem 1.2rem;font-weight:650;border-radius:5px}.primary:hover{text-decoration:none;filter:brightness(1.1)}.workbench{display:grid;grid-template-columns:1.8fr 1fr;border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:var(--shadow)}.terminal{background:var(--bg-soft);padding:1.3rem 1.5rem;font:.82rem var(--font-mono)}.bar{display:flex;gap:1rem;align-items:center;padding-bottom:1rem;border-bottom:1px solid var(--border);color:var(--text-faint);font-size:.7rem}.bar strong{color:var(--accent-2);font-size:.95rem}.ready{margin-left:auto;color:var(--accent-2)}.conversation{padding:1.5rem 0;line-height:1.65;min-height:320px}.conversation p{margin:.45rem 0}.conversation .label{font-size:.6rem;letter-spacing:.15em;color:var(--text-faint);margin-top:1.2rem}.conversation .label:first-child{margin-top:0}.conversation .agent{color:var(--accent-2)}.tool{padding:.4rem .65rem;border-left:2px solid var(--accent-2);margin:.7rem 0;color:var(--accent-2);background:var(--surface)}.tool span{color:var(--text-dim);padding-left:1rem}.composer{border-top:1px solid var(--border);padding:1.1rem 0;color:var(--accent-2);display:flex;gap:.7rem}.composer span{color:var(--text-faint)}.cursor{height:1.1rem;width:.5rem;background:var(--accent-2);opacity:.6}.keys{display:flex;justify-content:space-between;font-size:.6rem;color:var(--text-faint)}aside{padding:2rem;background:var(--surface);border-left:1px solid var(--border)}aside h2{font-size:1.7rem;line-height:1.2;margin:1.2rem 0}aside>p:not(.eyebrow){font-size:.83rem;color:var(--text-dim);line-height:1.8;margin:1.5rem 0}aside>a{font-size:.8rem;color:var(--accent-2)}.graph{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin:1.5rem 0}.graph span{font:.75rem var(--font-mono);border:1px solid var(--border);padding:.65rem;border-radius:4px;color:var(--text-dim)}.graph .selected{color:var(--accent-2);border-color:var(--accent-2)}.install{display:flex;align-items:center;justify-content:space-between;margin-top:1.3rem}.install code{font:.8rem var(--font-mono)}.install code span{color:var(--accent-2)}.install p{font-size:.7rem;color:var(--text-faint)}.modules{display:grid;grid-template-columns:1fr 1.3fr;gap:5rem;border-top:1px solid var(--border)}.modules h2,.closing h2{font-size:2.5rem;letter-spacing:-.04em;line-height:1.1;margin:1.2rem 0}.modules header>p:last-child{max-width:34ch;color:var(--text-dim);line-height:1.7}.module-list a{display:flex;gap:1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--border);align-items:center}.module-list a:first-child{padding-top:0}.module-list a>span{font:.75rem var(--font-mono);color:var(--accent-2)}.module-list a>span:last-child{margin-left:auto}.module-list h3{font-size:1.1rem;font-weight:550}.module-list p{font-size:.85rem;color:var(--text-dim);margin-top:.4rem}.closing{border-top:1px solid var(--border);text-align:center;padding-bottom:6rem}.closing p{color:var(--text-dim)}.closing .primary{margin-top:2rem}@media(max-width:800px){.headline{display:block}.headline>p{margin-top:1.5rem}.workbench,.modules{grid-template-columns:1fr}.modules{gap:2.5rem}aside{border-left:0;border-top:1px solid var(--border)}.install{align-items:start;gap:1rem;flex-direction:column}.intro,.modules,.closing{padding:2.8rem 1rem}.terminal{padding:1rem}.keys{gap:.7rem;flex-wrap:wrap}.bar{gap:.7rem}}
</style>
