{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@xandreed/core": [
        "packages/core/src/index.ts"
      ],
      "@xandreed/foundry": [
        "packages/foundry/src/index.ts"
      ],
      "@xandreed/foundry/domain/Rules.js": [
        "packages/foundry/src/domain/Rules.ts"
      ],
      "@xandreed/foundry/gates/rules/packs.js": [
        "packages/foundry/src/gates/rules/packs.ts"
      ],
      "@xandreed/website": [
        "packages/website/src/index.ts"
      ],
      "@xandreed/review": [
        "packages/review/src/index.ts"
      ],
      "@xandreed/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@xandreed/sdk/node": [
        "packages/sdk/src/node/index.ts"
      ],
      "@xandreed/evals": [
        "packages/evals/src/index.ts"
      ],
      "@xandreed/evals/stats": [
        "packages/evals/src/stats.ts"
      ],
      "@xandreed/evals/testing/fixture.testing": [
        "packages/evals/src/testing/fixture.testing.ts"
      ],
      "@xandreed/evals-cli": [
        "packages/evals-cli/src/index.ts"
      ],
      "@xandreed/evals-langfuse": [
        "packages/evals-langfuse/src/index.ts"
      ],
      "@xandreed/evals-langsmith": [
        "packages/evals-langsmith/src/index.ts"
      ]
    }
  }
}
