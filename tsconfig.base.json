{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@xandreed/core": [
        "packages/core/src/index.ts"
      ],
      "@xandreed/core/*": [
        "packages/core/src/*"
      ],
      "@xandreed/foundry": [
        "packages/foundry/src/index.ts"
      ],
      "@xandreed/foundry/*": [
        "packages/foundry/src/*"
      ],
      "@xandreed/plugin-render": [
        "packages/plugin-render/src/index.ts"
      ],
      "@xandreed/plugin-render/*": [
        "packages/plugin-render/src/*"
      ],
      "@xandreed/plugin-agent-loop": [
        "packages/plugin-agent-loop/src/index.ts"
      ],
      "@xandreed/runtime": [
        "packages/runtime/src/index.ts"
      ],
      "@xandreed/website": [
        "packages/website/src/index.ts"
      ],
      "@xandreed/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@xandreed/plugin-models": [
        "packages/plugin-models/src/index.ts"
      ],
      "@xandreed/plugin-session-sqlite": [
        "packages/plugin-session-sqlite/src/index.ts"
      ],
      "@xandreed/plugin-sessions": [
        "packages/plugin-sessions/src/index.ts"
      ],
      "@xandreed/plugin-memory": [
        "packages/plugin-memory/src/index.ts"
      ],
      "@xandreed/evals": [
        "packages/evals/src/index.ts"
      ],
      "@xandreed/evals/*": [
        "packages/evals/src/*.ts"
      ],
      "@xandreed/evals-cli": [
        "packages/evals-cli/src/index.ts"
      ],
      "@xandreed/evals-cli/*": [
        "packages/evals-cli/src/*.ts"
      ],
      "@xandreed/evals-langfuse": [
        "packages/evals-langfuse/src/index.ts"
      ],
      "@xandreed/evals-langsmith": [
        "packages/evals-langsmith/src/index.ts"
      ],
      "@xandreed/plugin-memory-window": [
        "packages/plugin-memory-window/src/index.ts"
      ],
      "@xandreed/plugin-memory-summary": [
        "packages/plugin-memory-summary/src/index.ts"
      ],
      "@xandreed/plugin-memory-digest": [
        "packages/plugin-memory-digest/src/index.ts"
      ],
      "@xandreed/plugin-tool-discovery": [
        "packages/plugin-tool-discovery/src/index.ts"
      ],
      "@xandreed/plugin-tasks": [
        "packages/plugin-tasks/src/index.ts"
      ]
    }
  }
}
